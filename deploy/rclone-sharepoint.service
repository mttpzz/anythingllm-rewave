# systemd unit to mount the SharePoint library at /mnt/sharepoint via rclone.
# Install:
#   sudo cp deploy/rclone-sharepoint.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rclone-sharepoint
#
# Prerequisites:
#   - rclone installed: curl https://rclone.org/install.sh | sudo bash
#   - remote configured: rclone config  (type OneDrive/SharePoint, remote "rewaveSP")
#     on a headless host: run `rclone authorize "onedrive"` from a machine with a
#     browser and paste the token into `rclone config` on the server.
#   - mount directory: sudo mkdir -p /mnt/sharepoint
#   - for --allow-other: enable `user_allow_other` in /etc/fuse.conf
#
# Keep this path in sync with SHAREPOINT_MOUNT_PATH in .env (used by docker-compose).

[Unit]
Description=rclone mount SharePoint (Rewave) at /mnt/sharepoint
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Adjust User/Group to the server service account (must have access to rclone.conf).
User=ubuntu
Group=ubuntu
Environment=RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf
ExecStartPre=/bin/mkdir -p /mnt/sharepoint
ExecStart=/usr/bin/rclone mount rewaveSP:"Documenti/CartellaTarget" /mnt/sharepoint \
    --vfs-cache-mode writes \
    --dir-cache-time 1m \
    --allow-other \
    --umask 022 \
    --log-level INFO
ExecStop=/bin/fusermount -u /mnt/sharepoint
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
